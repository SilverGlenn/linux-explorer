<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
  "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- Private API v1. Option/result details: docs/file-chooser-api.md.
     Request interface is exported at each returned request path, not service path. -->
<node>
  <interface name="org.win7explorer.FileChooser1">
    <property name="Version" type="u" access="read"/>
    <method name="OpenFile">
      <arg name="options" type="a{sv}" direction="in"/>
      <arg name="request" type="o" direction="out"/>
    </method>
    <method name="SaveFile">
      <arg name="options" type="a{sv}" direction="in"/>
      <arg name="request" type="o" direction="out"/>
    </method>
  </interface>
  <interface name="org.win7explorer.FileChooser1.Request">
    <method name="Cancel"/>
    <method name="Close"/>
    <method name="GetResult">
      <arg name="result" type="a{sv}" direction="out"/>
    </method>
    <signal name="Finished">
      <arg name="status" type="u"/>
      <arg name="result" type="a{sv}"/>
    </signal>
  </interface>
</node>
