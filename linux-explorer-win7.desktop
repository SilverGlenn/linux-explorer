[Desktop Entry]
Name=File Explorer (Windows 7 preview)
GenericName=File Manager
Comment=Windows 7–style Explorer, installed separately from your default file manager
Exec=explorer-win7 %U
Icon=system-file-manager
Terminal=false
Type=Application
Categories=System;FileTools;FileManager;
StartupNotify=true
StartupWMClass=linux-explorer-win7
Actions=Libraries;Computer;OpenHome;

[Desktop Action Libraries]
Name=Libraries
Exec=explorer-win7 libraries:///
Icon=folder-documents

[Desktop Action Computer]
Name=Computer
Exec=explorer-win7 computer:///
Icon=computer

[Desktop Action OpenHome]
Name=Open Home Folder
Exec=explorer-win7 "~"
Icon=user-home
