        <file alias="google-drive-base/drive-256.png">../../assets/images/google-drive-base/drive-256.png</file>
        <file alias="branch-closed.png">../../assets/images/branch-closed.png</file>
        <file alias="branch-closed@2x.png">../../assets/images/branch-closed@2x.png</file>
        <file alias="branch-open.png">../../assets/images/branch-open.png</file>
        <file alias="branch-open@2x.png">../../assets/images/branch-open@2x.png</file>
        <file alias="commandbar.png">../../assets/images/commandbar.png</file>
        <file alias="commandhover.png">../../assets/images/commandhover.png</file>
        <file alias="commandpress.png">../../assets/images/commandpress.png</file>
