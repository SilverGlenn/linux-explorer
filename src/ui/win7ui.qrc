    <qresource prefix="/win7">
        <file alias="google-drive-base/drive-16.png">../../assets/images/google-drive-base/drive-16.png</file>
        <file alias="google-drive-base/drive-24.png">../../assets/images/google-drive-base/drive-24.png</file>
